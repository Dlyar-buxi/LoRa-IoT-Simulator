# LoRa IoT Simulator — environment configuration
# Copy to .env and adjust as needed. All values are OPTIONAL; sensible
# defaults apply when unset. Every integration degrades silently if unavailable.

# --- MQTT telemetry export (optional) ---
# Broker the backend publishes telemetry to (topic: lora/device/data).
MQTT_BROKER_URL=mqtt://localhost:1883

# --- SQLite experiment persistence (optional) ---
# Master switch for recording experiments. Set to "false" to disable.
DB_ENABLED=true
# Path to the SQLite database file (git-ignored: *.db).
DB_PATH=experiments.db
